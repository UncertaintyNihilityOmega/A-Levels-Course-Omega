 "names": "<figure class=\"fig small\"><svg viewBox=\"-10 -13 351 449\" role=\"img\" aria-label=\"Skeletal formulas of nine benzene derivatives: methylbenzene, chlorobenzene, nitrobenzene, phenol, phenylamine, benzoic acid, 1-phenylethanone, 3-nitrobenzoic acid and 2,4,6-tribromophenol\"><path class=\"ln thick\" d=\"M62 32L86.2 46L86.2 74L62 88L37.8 74L37.8 46Z\"/><circle class=\"ln\" cx=\"62\" cy=\"60\" r=\"17\"/><path class=\"ln thick\" d=\"M62 32L62 16\"/><text class=\"tl tc\" x=\"62\" y=\"12\">CH₃</text><text class=\"tl tc\" x=\"62\" y=\"116\">methylbenzene</text><path class=\"ln thick\" d=\"M162 32L186.2 46L186.2 74L162 88L137.8 74L137.8 46Z\"/><circle class=\"ln\" cx=\"162\" cy=\"60\" r=\"17\"/><path class=\"ln thick\" d=\"M162 32L162 16\"/><text class=\"tl tc\" x=\"162\" y=\"12\">Cl</text><text class=\"tl tc\" x=\"162\" y=\"116\">chlorobenzene</text><path class=\"ln thick\" d=\"M262 32L286.2 46L286.2 74L262 88L237.8 74L237.8 46Z\"/><circle class=\"ln\" cx=\"262\" cy=\"60\" r=\"17\"/><path class=\"ln thick\" d=\"M262 32L262 16\"/><text class=\"tl tc\" x=\"262\" y=\"12\">NO₂</text><text class=\"tl tc\" x=\"262\" y=\"116\">nitrobenzene</text><path class=\"ln thick\" d=\"M62 157L86.2 171L86.2 199L62 213L37.8 199L37.8 171Z\"/><circle class=\"ln\" cx=\"62\" cy=\"185\" r=\"17\"/><path class=\"ln thick\" d=\"M62 157L62 141\"/><text class=\"tl tc\" x=\"62\" y=\"137\">OH</text><text class=\"tl tc\" x=\"62\" y=\"241\">phenol</text><path class=\"ln thick\" d=\"M162 157L186.2 171L186.2 199L162 213L137.8 199L137.8 171Z\"/><circle class=\"ln\" cx=\"162\" cy=\"185\" r=\"17\"/><path class=\"ln thick\" d=\"M162 157L162 141\"/><text class=\"tl tc\" x=\"162\" y=\"137\">NH₂</text><text class=\"tl tc\" x=\"162\" y=\"241\">phenylamine</text><path class=\"ln thick\" d=\"M262 157L286.2 171L286.2 199L262 213L237.8 199L237.8 171Z\"/><circle class=\"ln\" cx=\"262\" cy=\"185\" r=\"17\"/><path class=\"ln thick\" d=\"M262 157L262 141\"/><text class=\"tl tc\" x=\"262\" y=\"137\">COOH</text><text class=\"tl tc\" x=\"262\" y=\"241\">benzoic acid</text><path class=\"ln thick\" d=\"M62 292L86.2 306L86.2 334L62 348L37.8 334L37.8 306Z\"/><circle class=\"ln\" cx=\"62\" cy=\"320\" r=\"17\"/><path class=\"ln thick\" d=\"M62 292L62 276\"/><text class=\"tl tc\" x=\"62\" y=\"272\">OH</text><path class=\"ln thick\" d=\"M86.2 306L100.1 298\"/><text class=\"tl\" x=\"104.1\" y=\"302\">Br</text><path class=\"ln thick\" d=\"M62 348L62 364\"/><text class=\"tl tc\" x=\"62\" y=\"378\">Br</text><path class=\"ln thick\" d=\"M37.8 306L23.9 298\"/><text class=\"tl\" x=\"19.9\" y=\"302\" text-anchor=\"end\">Br</text><text class=\"tl tc\" x=\"62\" y=\"402\">2,4,6-tribromo-</text><text class=\"tl tc\" x=\"62\" y=\"418\">phenol</text><path class=\"ln thick\" d=\"M162 292L186.2 306L186.2 334L162 348L137.8 334L137.8 306Z\"/><circle class=\"ln\" cx=\"162\" cy=\"320\" r=\"17\"/><path class=\"ln thick\" d=\"M162 292L162 272\"/><path class=\"ln thick\" d=\"M161.5 268.8L151.1 262.8\"/><path class=\"ln thick\" d=\"M159 273.2L148.6 267.2\"/><text class=\"tl tc\" x=\"144.7\" y=\"261\">O</text><path class=\"ln thick\" d=\"M162 272L177.3 263\"/><text class=\"tl\" x=\"181.3\" y=\"261\">CH₃</text><text class=\"tl tc\" x=\"162\" y=\"402\">1-phenyl-</text><text class=\"tl tc\" x=\"162\" y=\"418\">ethanone</text><path class=\"ln thick\" d=\"M262 292L286.2 306L286.2 334L262 348L237.8 334L237.8 306Z\"/><circle class=\"ln\" cx=\"262\" cy=\"320\" r=\"17\"/><path class=\"ln thick\" d=\"M262 292L262 276\"/><text class=\"tl tc\" x=\"262\" y=\"272\">COOH</text><path class=\"ln thick\" d=\"M286.2 334L300.1 342\"/><text class=\"tl\" x=\"304.1\" y=\"346\">NO₂</text><text class=\"tl tc\" x=\"262\" y=\"402\">3-nitro-</text><text class=\"tl tc\" x=\"262\" y=\"418\">benzoic acid</text></svg><figcaption>Nine aromatic compounds. Each ring is a hexagon with a circle for the delocalised electrons; the carbon holding the main group is number 1, and the others are numbered round the ring.</figcaption></figure>",
 "kekule": "<figure class=\"fig small\"><svg viewBox=\"14 37 302 134\" role=\"img\" aria-label=\"Two drawings of benzene: the Kekulé model with alternating double bonds, and the modern model with a circle in the ring\"><path class=\"ln thick\" d=\"M85 52L109.2 66L109.2 94L85 108L60.8 94L60.8 66Z\"/><path class=\"ln thick\" d=\"M86.8 58.8L102.4 67.8\"/><path class=\"ln thick\" d=\"M102.4 92.2L86.8 101.2\"/><path class=\"ln thick\" d=\"M65.8 89L65.8 71\"/><text class=\"tl tc\" x=\"85\" y=\"135\">Kekulé model</text><text class=\"tl tc\" x=\"85\" y=\"153\">3 × C=C, 3 × C–C</text><path class=\"ln thick\" d=\"M255 52L279.2 66L279.2 94L255 108L230.8 94L230.8 66Z\"/><circle class=\"ln\" cx=\"255\" cy=\"80\" r=\"17\"/><text class=\"tl tc\" x=\"255\" y=\"135\">modern model</text><text class=\"tl tc\" x=\"255\" y=\"153\">6 equal bonds</text><path class=\"ln-m thin dash\" d=\"M135 80L205 80\"/><text class=\"tl tc\" x=\"170\" y=\"76\">not</text></svg><figcaption>Two ways to draw benzene. The Kekulé drawing implies three short C=C bonds and three longer C–C bonds; every bond in real benzene is the same length, so the circle is used.</figcaption></figure>",
 "pi": "<figure class=\"fig small\"><svg viewBox=\"20 19 300 191\" role=\"img\" aria-label=\"Six p orbitals above and below a flat hexagonal ring of carbon atoms overlapping to form a delocalised pi system\"><ellipse class=\"fa\" cx=\"135\" cy=\"69.5\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"135\" cy=\"109.5\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"205\" cy=\"69.5\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"205\" cy=\"109.5\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"240\" cy=\"92\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"240\" cy=\"132\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"100\" cy=\"92\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"100\" cy=\"132\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"205\" cy=\"114.5\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"205\" cy=\"154.5\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"135\" cy=\"114.5\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"135\" cy=\"154.5\" rx=\"13\" ry=\"16\"/><path class=\"ln thick\" d=\"M240 112L205 134.5L135 134.5L100 112L135 89.5L205 89.5Z\"/><text class=\"tl tc\" x=\"170\" y=\"44\">π electrons above</text><text class=\"tl tc\" x=\"170\" y=\"192\">π electrons below</text></svg><figcaption>Benzene seen from slightly above. Each carbon has one p orbital at right angles to the flat ring; neighbouring p orbitals overlap sideways, so the π electrons form one ring above and one below the plane of the σ bonds.</figcaption></figure>",
 "pi_o": "<figure class=\"fig small\"><svg viewBox=\"26 19 300 191\" role=\"img\" aria-label=\"The p orbital of the oxygen atom of phenol, holding a lone pair, overlapping with the six p orbitals of the benzene ring\"><ellipse class=\"fa\" cx=\"95\" cy=\"69.5\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"95\" cy=\"109.5\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"165\" cy=\"69.5\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"165\" cy=\"109.5\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"200\" cy=\"92\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"200\" cy=\"132\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"60\" cy=\"92\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"60\" cy=\"132\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"165\" cy=\"114.5\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"165\" cy=\"154.5\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"95\" cy=\"114.5\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa\" cx=\"95\" cy=\"154.5\" rx=\"13\" ry=\"16\"/><path class=\"ln thick\" d=\"M200 112L165 134.5L95 134.5L60 112L95 89.5L165 89.5Z\"/><path class=\"ln thick\" d=\"M200 112L244 112\"/><ellipse class=\"fa2\" cx=\"256\" cy=\"88\" rx=\"13\" ry=\"16\"/><ellipse class=\"fa2\" cx=\"256\" cy=\"136\" rx=\"13\" ry=\"16\"/><text class=\"tl tc\" x=\"256\" y=\"116\">OH</text><circle class=\"fi\" cx=\"253\" cy=\"88\" r=\"1.7\"/><circle class=\"fi\" cx=\"259\" cy=\"88\" r=\"1.7\"/><text class=\"tl tc\" x=\"256\" y=\"174\">lone pair in a</text><text class=\"tl tc\" x=\"256\" y=\"190\">p orbital on O</text><text class=\"tl tc\" x=\"130\" y=\"44\">π electrons above</text><text class=\"tl tc\" x=\"130\" y=\"192\">π electrons below</text></svg><figcaption>Phenol seen from slightly above. The p orbital on oxygen that holds a lone pair is parallel to the ring's p orbitals, so it overlaps sideways with them and the lone pair joins the delocalised π system.</figcaption></figure>",
 "mech": "<figure class=\"fig small\"><svg viewBox=\"-21 23 300 418\" role=\"img\" aria-label=\"Electrophilic substitution of benzene: the delocalised ring donates a pair of electrons to the electrophile NO₂⁺, giving an intermediate cation with hydrogen and NO₂ on one carbon; the C–H bond electrons then return to the ring, releasing H+ and giving the substituted benzene\"><path class=\"ln thick\" d=\"M80 38L104.2 52L104.2 80L80 94L55.8 80L55.8 52Z\"/><circle class=\"ln\" cx=\"80\" cy=\"66\" r=\"17\"/><text class=\"tl\" x=\"162\" y=\"71\">NO₂⁺</text><path class=\"c1 sw2\" d=\"M94.7 57.5Q132 28 157 63\" marker-end=\"url(#ahs-red)\"/><text class=\"tl\" x=\"120\" y=\"71\">+</text><path class=\"ln\" d=\"M80 104L80 138\" marker-end=\"url(#ah)\"/><text class=\"tl\" x=\"92\" y=\"125\">step 1 (slow)</text><path class=\"ln thick\" d=\"M80 210L104.2 224L104.2 252L80 266L55.8 252L55.8 224Z\"/><path class=\"ln\" d=\"M94.7 229.5A17 17 0 1 1 65.3 229.5\"/><text class=\"tl tc\" x=\"80\" y=\"243\">+</text><path class=\"ln thick\" d=\"M80 210L64.4 201\"/><path class=\"ln thick\" d=\"M80 210L95.6 201\"/><text class=\"tl\" x=\"61.4\" y=\"203\" text-anchor=\"end\">H</text><text class=\"tl\" x=\"98.6\" y=\"203\">NO₂</text><path class=\"c1 sw2\" d=\"M72.7 206.5Q42 216 70 242\" marker-end=\"url(#ahs-red)\"/><text class=\"tl\" x=\"120\" y=\"243\">intermediate</text><path class=\"ln\" d=\"M80 276L80 310\" marker-end=\"url(#ah)\"/><text class=\"tl\" x=\"92\" y=\"297\">step 2 (fast)</text><path class=\"ln thick\" d=\"M80 370L104.2 384L104.2 412L80 426L55.8 412L55.8 384Z\"/><circle class=\"ln\" cx=\"80\" cy=\"398\" r=\"17\"/><path class=\"ln thick\" d=\"M80 370L80 352\"/><text class=\"tl tc\" x=\"80\" y=\"348\">NO₂</text><text class=\"tl\" x=\"124\" y=\"403\">+ H⁺</text></svg><figcaption>Electrophilic substitution of benzene by NO₂⁺. Step 1: a pair of electrons from the delocalised ring forms a bond to the electrophile; the intermediate has a partial ring (the arc) and a positive charge. Step 2: the electrons of the C–H bond return to the ring and H⁺ leaves.</figcaption></figure>",
 "delta": "<figure class=\"fig small\"><svg viewBox=\"-50 5 300 143\" role=\"img\" aria-label=\"Phenol with the OH carbon numbered 1 and delta-minus marked at positions 2, 4 and 6 of the ring\"><path class=\"ln thick\" d=\"M100 52L124.2 66L124.2 94L100 108L75.8 94L75.8 66Z\"/><circle class=\"ln\" cx=\"100\" cy=\"80\" r=\"17\"/><path class=\"ln thick\" d=\"M100 52L100 34\"/><text class=\"tl tc\" x=\"100\" y=\"30\">OH</text><text class=\"tl ta\" x=\"130.2\" y=\"62\">δ−</text><text class=\"tl ta tc\" x=\"100\" y=\"130\">δ−</text><text class=\"tl ta\" x=\"69.8\" y=\"62\" text-anchor=\"end\">δ−</text></svg><figcaption>In phenol the oxygen lone pair raises the electron density at carbons 2, 4 and 6 (the positions next to and opposite the OH group), so electrophiles attack there.</figcaption></figure>",
 "azo": "<figure class=\"fig small\"><svg viewBox=\"-35 16 301 274\" role=\"img\" aria-label=\"Azo coupling: benzenediazonium ion reacts with phenol in sodium hydroxide solution below 10 degrees Celsius to give an azo compound in which the N=N group joins the two rings, with the OH group opposite it\"><path class=\"ln thick\" d=\"M78 56L64 31.8L36 31.8L22 56L36 80.2L64 80.2Z\"/><circle class=\"ln\" cx=\"50\" cy=\"56\" r=\"17\"/><path class=\"ln thick\" d=\"M78 56L92 56\"/><text class=\"tl\" x=\"96\" y=\"60\">N≡N⁺</text><text class=\"tl\" x=\"132\" y=\"60\">+</text><path class=\"ln thick\" d=\"M208 56L194 31.8L166 31.8L152 56L166 80.2L194 80.2Z\"/><circle class=\"ln\" cx=\"180\" cy=\"56\" r=\"17\"/><path class=\"ln thick\" d=\"M208 56L222 56\"/><text class=\"tl\" x=\"226\" y=\"60\">OH</text><text class=\"tl tc\" x=\"50\" y=\"112\">benzenediazonium ion</text><text class=\"tl tc\" x=\"186\" y=\"112\">phenol</text><path class=\"ln\" d=\"M90 136L90 174\" marker-end=\"url(#ah)\"/><text class=\"tl\" x=\"104\" y=\"154\">NaOH(aq), below 10 °C</text><path class=\"ln thick\" d=\"M78 220L64 195.8L36 195.8L22 220L36 244.2L64 244.2Z\"/><circle class=\"ln\" cx=\"50\" cy=\"220\" r=\"17\"/><path class=\"ln thick\" d=\"M78 220L92 220\"/><text class=\"tl\" x=\"95\" y=\"224\">N</text><path class=\"ln thick\" d=\"M105 217.5L119 217.5\"/><path class=\"ln thick\" d=\"M105 222.5L119 222.5\"/><text class=\"tl\" x=\"122\" y=\"224\">N</text><path class=\"ln thick\" d=\"M196 220L182 195.8L154 195.8L140 220L154 244.2L182 244.2Z\"/><circle class=\"ln\" cx=\"168\" cy=\"220\" r=\"17\"/><path class=\"ln thick\" d=\"M134 220L140 220\"/><path class=\"ln thick\" d=\"M196 220L210 220\"/><text class=\"tl\" x=\"214\" y=\"224\">OH</text><text class=\"tl tc\" x=\"128\" y=\"272\">an azo compound: Ar–N=N–Ar′</text></svg><figcaption>Azo coupling. The diazonium ion attacks the ring of phenol at the position opposite the OH group (the 4-position), and the two rings end up joined by the N=N (azo) group.</figcaption></figure>",
 "naph": "<figure class=\"fig small\"><svg viewBox=\"-8 11 300 102\" role=\"img\" aria-label=\"Skeletal formula of 2-naphthol, two fused benzene rings with an OH group on carbon 2 and carbon 1 marked next to it\"><path class=\"ln thick\" d=\"M60 42L84.2 56L84.2 84L60 98L35.8 84L35.8 56Z\"/><circle class=\"ln\" cx=\"60\" cy=\"70\" r=\"17\"/><path class=\"ln thick\" d=\"M108.5 42L132.7 56L132.7 84L108.5 98L84.2 84L84.2 56Z\"/><circle class=\"ln\" cx=\"108.5\" cy=\"70\" r=\"17\"/><path class=\"ln thick\" d=\"M132.7 56L148.3 47\"/><text class=\"tl\" x=\"152.3\" y=\"51\">OH</text><text class=\"tl ta\" x=\"116.5\" y=\"36\">1</text><text class=\"tl\" x=\"178.5\" y=\"74\">2-naphthol</text></svg><figcaption>2-Naphthol: two fused rings with OH on carbon 2. The diazonium ion attacks carbon 1, next to the OH group.</figcaption></figure>"
